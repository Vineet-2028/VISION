{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel local video sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "videoId",
    "scenario",
    "calibrationId",
    "resolution",
    "timingProvenance",
    "lighting",
    "environment",
    "notes",
    "groundTruthStatus"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "videoId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "scenario": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "INDOOR",
          "SIDEWALK",
          "ROAD_EDGE",
          "CAMPUS",
          "CROSSWALK",
          "STAIRS",
          "CROWD",
          "LOW_LIGHT",
          "HIGH_MOTION",
          "STATIC_CAMERA"
        ]
      }
    },
    "calibrationId": { "type": ["string", "null"] },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "timingProvenance": {
      "enum": ["AUTHORITATIVE_PTS", "DERIVED_FROM_RATE", "SYNTHETIC", "UNKNOWN"]
    },
    "lighting": { "type": "string" },
    "environment": { "type": "string" },
    "notes": { "type": "string" },
    "groundTruthStatus": { "enum": ["NONE", "PARTIAL", "VERIFIED"] }
  }
}
